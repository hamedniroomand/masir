# 32+ random characters — e.g. openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-secret-with-at-least-32-chars

# Salt secret for the daily visitor hash. Falls back to NUXT_SESSION_PASSWORD.
# Set it so rotating the session password does not reset visitor counts.
NUXT_VISITOR_HASH_SECRET=

# Largest connection pool for one instance. Lower it on serverless.
NUXT_DATABASE_POOL_MAX=10

# Apply migrations when the server starts. Turn it off on serverless, where
# every cold start would run it, and migrate as a deploy step instead.
NUXT_MIGRATE_ON_BOOT=true

# Postgres connection string. Ignored by compose.yaml and compose.dev.yaml,
# which build their own from the db service.
NUXT_DATABASE_URL=postgres://masir:masir@127.0.0.1:5432/masir

# Database the tests connect to. They create masir_test_<file> from it and
# never touch the application database. compose.dev.yaml makes it on the first
# start. Use the host db from inside the app container.
TEST_DATABASE_URL=postgres://masir:masir@127.0.0.1:5432/masir_test

# Password of the Postgres in compose.yaml. e.g. openssl rand -hex 24
POSTGRES_PASSWORD=

# Host ports that Docker Compose publishes. The port inside the container
# never changes. Change NUXT_ROOT_DOMAIN and NUXT_PUBLIC_SHORT_DOMAIN as well
# when you move the app port.
MASIR_APP_PORT=3000
# Image tag that compose.image.yaml pulls. A version such as 1.2.0 pins it.
MASIR_VERSION=latest
# The next three are read by compose.dev.yaml only
MASIR_DB_PORT=5432
MASIR_MAIL_SMTP_PORT=1025
MASIR_MAIL_UI_PORT=8025

# Origin printed with short links (no trailing slash)
NUXT_PUBLIC_SHORT_DOMAIN=http://localhost:3000

# Allow http://192.168.x.x destinations (default false)
NUXT_ALLOW_PRIVATE_DESTINATIONS=false

# Header name for country code (optional; set by CDN/proxy)
NUXT_GEO_COUNTRY_HEADER=

# Login attempts for each client and for each address. argon2id holds 64MiB
# for every check, so this bounds memory as well as guessing.
NUXT_RATE_LIMIT_LOGIN_PER_MINUTE=10

# Shared rate-limit counters. Empty means each instance counts alone, so every
# limit is multiplied by the instance count. Use the Upstash TLS endpoint
# (rediss://...upstash.io:6379), not the REST URL.
NUXT_REDIS_URL=

# Number of trusted proxies in front of the app. 0 ignores X-Forwarded-For.
# Set it to 1 behind one nginx or one CDN. Too high lets a caller forge their
# own address and reset every rate limit.
NUXT_TRUSTED_PROXY_DEPTH=0

NUXT_RATE_LIMIT_CREATE_PER_HOUR=30
# Link limits are keyed by workspace, so this one stops a caller resetting them
# by making new workspaces.
NUXT_RATE_LIMIT_WORKSPACE_PER_DAY=5
NUXT_RATE_LIMIT_REDIRECT_PER_MINUTE=120
NUXT_RATE_LIMIT_UPDATE_PER_MINUTE=60
NUXT_RATE_LIMIT_PASSWORD_PER_MINUTE=10
NUXT_RATE_LIMIT_SLUG_CHECK_PER_MINUTE=30
NUXT_RATE_LIMIT_INVITE_PER_HOUR=30

# First admin (scripts/seed-admin.ts only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# CLOUD or SELF_HOSTED
NUXT_DEPLOYMENT_MODE=SELF_HOSTED

# Origin of the root site, with protocol and port
NUXT_ROOT_DOMAIN=http://localhost:3000

# true gives each workspace its own subdomain and needs wildcard DNS
NUXT_MULTI_WORKSPACE=false

# true lets anybody register
NUXT_ALLOW_REGISTRATION=false

# Origin for sign-in and the dashboard, such as https://app.example.com. Empty
# keeps them on the root, which then serves no landing page.
NUXT_APP_DOMAIN=

# false only for plain HTTP on a private network.
NUXT_SESSION_COOKIE_SECURE=true

# true on a host that keeps no disk between requests. The vercel preset sets it
# at build. Set it yourself on a container with no volume.
NUXT_SERVERLESS=

# How often the instance sweeps for links that expire soon, and for demo
# workspaces whose time has passed. 0 turns the in-process sweep off; a
# serverless deployment leaves it off and points a cron at POST /api/jobs/alerts.
NUXT_ALERTS_INTERVAL_MINUTES=15

# Bearer token for POST /api/jobs/alerts. Empty makes the route answer 404.
NUXT_JOBS_SECRET=

# true puts a "Try the demo" button on the landing page. Each visitor gets a
# seeded workspace that holds 9 links and is deleted after 24 hours. Needs
# NUXT_MULTI_WORKSPACE=true and an app domain, because the root serves the
# landing page only when the app lives somewhere else.
NUXT_DEMO_ENABLED=false

# Mail provider: smtp, resend, outbox or log. Leave empty to pick smtp when
# NUXT_MAIL_SMTP_HOST is set, then resend, then the log driver.
NUXT_MAIL_DRIVER=

# From header on every message
NUXT_MAIL_FROM=Masir <no-reply@localhost>

# SMTP provider. compose.dev.yaml starts Mailpit for development: use host
# 127.0.0.1 from "bun dev" on this machine, or mail from inside compose.
# Read the caught mail at http://localhost:8025
NUXT_MAIL_SMTP_HOST=
NUXT_MAIL_SMTP_PORT=587
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASSWORD=
# true for implicit TLS on port 465. false lets STARTTLS upgrade port 587.
NUXT_MAIL_SMTP_SECURE=false
# Largest number of open SMTP connections in the pool
NUXT_MAIL_SMTP_POOL_MAX=5

# Resend provider API key
NUXT_MAIL_API_KEY=

# Storage provider: file or s3. Leave empty to pick s3 when
# NUXT_STORAGE_BUCKET is set, then file.
NUXT_STORAGE_DRIVER=

# The file provider needs a disk that lives longer than one request, so it
# works on a VPS or a container with a mounted volume. It does NOT work on an
# edge or serverless host; the boot refuses it when NUXT_DEPLOYMENT_MODE=CLOUD.
# The app serves these files at /uploads, so keep that path in the public URL.
NUXT_STORAGE_LOCAL_ROOT=./data/uploads

# Set all four for the s3 provider. R2 uses the same values with an R2 endpoint.
NUXT_STORAGE_ACCESS_KEY_ID=
NUXT_STORAGE_SECRET_ACCESS_KEY=
NUXT_STORAGE_BUCKET=
NUXT_STORAGE_ENDPOINT=

# Public prefix for reading uploads
NUXT_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Largest logo accepted, in bytes. 2 MiB.
NUXT_STORAGE_MAX_UPLOAD_BYTES=2097152

# Leave a client id empty to hide that provider's button.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_MICROSOFT_CLIENT_ID=
NUXT_OAUTH_MICROSOFT_CLIENT_SECRET=
NUXT_OAUTH_MICROSOFT_TENANT=common

# Cloudflare Turnstile. Both set shows the robot check on the email sign-in and sign-up forms.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# GA4 measurement ID. Empty keeps Google Analytics off.
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=

# Umami website ID. Empty keeps Umami off.
NUXT_PUBLIC_SCRIPTS_UMAMI_ANALYTICS_WEBSITE_ID=
# Origin of a self-hosted Umami, such as https://umami.example.com. Empty uses Umami Cloud.
NUXT_PUBLIC_SCRIPTS_UMAMI_ANALYTICS_HOST_URL=
# true loads the Umami recorder for replays and heatmaps. Also turn them on in the Umami website settings.
NUXT_PUBLIC_SCRIPTS_UMAMI_ANALYTICS_REPLAYS=false

# Sentry. Empty keeps error reporting off. Set the DSN to turn it on.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Release name. Empty takes the version of the image.
NUXT_PUBLIC_SENTRY_RELEASE=
# Source maps. With all three set, the container uploads the maps of its own
# build to this project when it starts. SENTRY_URL is for your own Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# Required when NUXT_MULTI_WORKSPACE is true. The leading dot shares the
# session across every workspace subdomain.
NUXT_SESSION_COOKIE_DOMAIN=
