{
  "name": "masir",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "description": "Every link has a destination.",
  "workspaces": [
    "docs"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "docker compose -f compose.dev.yaml up",
    "preview": "nuxt preview",
    "docs:dev": "bun --filter masir-docs dev",
    "docs:build": "bun --filter masir-docs build",
    "docs:preview": "bun --filter masir-docs preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "pretest": "sh scripts/test-db.sh",
    "test": "bun --bun vitest run",
    "pretest:browser": "sh scripts/test-db.sh && sh scripts/stop-browser-servers.sh",
    "pretest:browser:run": "sh scripts/test-db.sh",
    "test:browser": "bun run build && playwright test",
    "test:browser:run": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:seed:admin": "bun run scripts/seed-admin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.133",
    "@iconify-json/simple-icons": "^1.2.96",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.1",
    "drizzle-orm": "rc",
    "nodemailer": "^10.0.10",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "std-env": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "drizzle-kit": "rc",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*": "bun lint --fix"
  }
}
